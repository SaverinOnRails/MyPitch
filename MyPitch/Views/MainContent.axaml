<UserControl
    x:Class="MyPitch.Views.MainContent"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyPitch.Controls"
    xmlns:converters="using:MyPitch.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="using:ShadUI"
    xmlns:vm="using:MyPitch.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:TonicDisplayConverter x:Key="TonicDisplayConverter" />
        <converters:ScaleModeDisplayConverter x:Key="ScaleModeDisplayConverter" />
        <converters:GameModeDisplayConverter x:Key="GameModeDisplayConverter" />
        <FontFamily x:Key="NotoSans">avares://MyPitch/Assets/Fonts/#Noto Sans</FontFamily>
    </UserControl.Resources>

    <UserControl.Styles>
        <Styles>
            <Style Selector=":is(Control).mode-panel">
                <Setter Property="ClipToBounds" Value="True" />
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Height" Duration="0:0:0.30" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector=":is(Control).fade-panel">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="controls|MelodyBar.mode-panel">
                <Setter Property="Height" Value="50" />
            </Style>
            <Style Selector="StackPanel.mode-panel">
                <Setter Property="Height" Value="40" />
            </Style>
            <Style Selector="controls|FolkMediaControl.mode-panel">
                <Setter Property="Height" Value="90" />
            </Style>

            <Style Selector=":is(Control).mode-panel.collapsed">
                <Setter Property="Height" Value="0" />
            </Style>

            <Style Selector=":is(Control).fade-panel.collapsed">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="IsVisible" Value="false" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Styles>
    </UserControl.Styles>
    <Grid
        x:Name="LayoutMain"
        Margin="10,0,0,0"
        Container.Name="main">
        <Grid x:Name="CircleDisplay" RowDefinitions="Auto,*">
            <controls:MelodyBar
                BarState="{Binding Game.MelodyBarState}"
                Classes="mode-panel"
                Classes.collapsed="{Binding !IsMelodyMode}"
                NoteCount="{Binding MelodyNoteCount}" />

            <StackPanel
                Margin="5"
                Classes="mode-panel"
                Classes.collapsed="{Binding !IsInteractiveMode}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="30"
                    Text="{Binding Game.InteractiveModeRounds, StringFormat={}{0}/20}" />
            </StackPanel>

            <controls:FolkMediaControl
                Classes="mode-panel"
                Classes.collapsed="{Binding !IsFolkMode}"
                FolkMediaDuration="{Binding Game.FolkMediaDuration}"
                FolkMediaProgress="{Binding Game.FolkMediaProgress}"
                PlaybackSpeed="{Binding Game.PlaybackSpeed, Mode=TwoWay}"
                SeekCommand="{Binding FolkMediaSeek}" />

            <controls:ChordQualityInput
                Grid.Row="1"
                AnswerState="{Binding Game.AnswerState}"
                Classes="fade-panel"
                Classes.collapsed="{Binding !IsChordQualityMode}"
                GameResponse="{Binding Game.GameResponse}"
                IncludedMultiSelectable="{Binding ChordQualities}"
                Tonic="{Binding Game.Tonic}"
                UserResponse="{Binding Game.UserResponse, Mode=TwoWay}" />

            <controls:CircleOfFifths
                Grid.Row="1"
                Margin="10"
                AnswerState="{Binding Game.AnswerState}"
                ClipToBounds="False"
                Classes="fade-panel"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes.collapsed="{Binding HideCircleOfFifths}"
                GameResponse="{Binding Game.GameResponse}"
                GameMode="{Binding GameMode}"
                IncludedMultiSelectable="{Binding Degrees}"
                Octave="{Binding Game.Octave}"
                RepeatCommand="{Binding Repeat}"
                Tonic="{Binding Game.Tonic}"
                UserResponse="{Binding Game.UserResponse, Mode=TwoWay}" />
        </Grid>
        <shadui:Card
            x:Name="Card"
            MaxWidth="700"
            Margin="0,10,5,10"
            HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,*">
                    <shadui:CardTitle>Customize</shadui:CardTitle>
                    <Button
                        x:Name="NarrowLayoutCardResizer"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Classes="Ghost"
                        Click="NarrowLayoutCardResizer_Click"
                        FontSize="15" />
                </Grid>
                <Border>
                    <TextBlock IsVisible="{Binding IsWasm}" Text="Enjoy superior performance on the desktop or mobile app" />
                </Border>
                <ComboBox
                    shadui:ControlAssist.Label="Select Game Mode"
                    ItemsSource="{Binding GameModes}"
                    SelectedValue="{Binding GameMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource GameModeDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding GameModeNeedTonicControl}">
                    <ComboBox
                        shadui:ControlAssist.Label="Select Tonic"
                        IsEnabled="{Binding !UseRandomTonic}"
                        ItemsSource="{Binding Tonics}"
                        SelectedItem="{Binding Game.Tonic}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{StaticResource NotoSans}" Text="{Binding Converter={StaticResource TonicDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleSwitch
                        Grid.Column="1"
                        Margin="10,30,10,0"
                        IsChecked="{Binding UseRandomTonic}"
                        OffContent="Random"
                        OnContent="Random" />
                </Grid>
                <ToggleSwitch
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    IsChecked="{Binding PlayDrone}"
                    IsVisible="{Binding GameModeNeedDroneControl}"
                    OffContent="Play Drone"
                    OnContent="Play Drone" />

                <StackPanel IsVisible="{Binding GameModeNeedDroneControl}">
                    <TextBlock
                        FontSize="15"
                        FontWeight="DemiBold"
                        Text="{Binding Game.DroneVolume, StringFormat='Drone Volume : {0}%'}" />
                    <Slider
                        shadui:ControlAssist.Label="Volume"
                        IsSnapToTickEnabled="True"
                        Maximum="100"
                        Minimum="0"
                        TickFrequency="10"
                        TickPlacement="BottomRight"
                        Value="{Binding Game.DroneVolume}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    IsChecked="{Binding PlayCadenceOnKeyChange}"
                    IsVisible="{Binding GameModeNeedTonicControl}"
                    OffContent="Play Cadence On Key Change"
                    OnContent="Play Cadence On Key Change" />
                <StackPanel IsVisible="{Binding GameModeNeedOctaveControl}">
                    <TextBlock
                        FontSize="15"
                        FontWeight="DemiBold"
                        Text="{Binding Game.Octave, StringFormat='Octave : {0}'}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider
                            shadui:ControlAssist.Label="Octave"
                            IsEnabled="{Binding !UseRandomOctave}"
                            IsSnapToTickEnabled="True"
                            Maximum="5"
                            Minimum="1"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            Value="{Binding Game.Octave}" />
                        <ToggleSwitch
                            Grid.Column="1"
                            Margin="20,0,10,0"
                            IsChecked="{Binding UseRandomOctave}"
                            OffContent="Random"
                            OnContent="Random" />
                    </Grid>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsMelodyMode}">
                    <TextBlock
                        FontSize="15"
                        FontWeight="DemiBold"
                        Text="{Binding MelodyNoteCount, StringFormat='Notes in melody : {0}'}" />
                    <Slider
                        shadui:ControlAssist.Label="Notes in melody"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="2"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="{Binding MelodyNoteCount}" />
                    <TextBlock
                        FontSize="15"
                        FontWeight="DemiBold"
                        Text="{Binding MelodyNoteGap, StringFormat='Melody Notes Delay (s) : {0}'}" />
                    <Slider
                        shadui:ControlAssist.Label="Melody Note Delay"
                        IsSnapToTickEnabled="True"
                        Maximum="3"
                        Minimum="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="{Binding MelodyNoteGap}" />
                </StackPanel>

                <Button
                    Classes="Primary"
                    Command="{Binding OpenFoldDatabaseDialog}"
                    Content="Folk Database"
                    IsVisible="{Binding IsFolkMode}" />
                <ComboBox
                    shadui:ControlAssist.Label="Select Scale Mode"
                    IsVisible="{Binding GameModeNeedScaleControl}"
                    ItemsSource="{Binding ScaleModes}"
                    SelectedValue="{Binding ScaleMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource ScaleModeDisplayConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Expander Padding="20" IsVisible="{Binding GameModeNeedScaleControl}">
                    <Expander.Header>
                        <TextBlock FontSize="16">
                            Included Scale Degrees
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Orientation="Vertical">
                        <StackPanel.Styles>
                            <Style Selector="CheckBox">
                                <Setter Property="FontSize" Value="20" />
                            </Style>
                        </StackPanel.Styles>
                        <Grid ColumnDefinitions="*,*">
                            <CheckBox Content="Select All" IsChecked="{Binding ShouldSelectAllDegrees}" />
                        </Grid>
                        <ItemsControl Margin="28,0,0,0" ItemsSource="{Binding Degrees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid ColumnSpacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,2"
                                        Content="{Binding Label}"
                                        FontFamily="{StaticResource NotoSans}"
                                        IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Expander Padding="20" IsVisible="{Binding IsChordQualityMode}">
                    <Expander.Header>
                        <TextBlock FontSize="16">
                            Included Chord Qualities
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel Orientation="Vertical">
                        <StackPanel.Styles>
                            <Style Selector="CheckBox">
                                <Setter Property="FontSize" Value="20" />
                            </Style>
                        </StackPanel.Styles>
                        <!-- <Grid ColumnDefinitions="*,*"> -->
                        <!-- <CheckBox Content="Select All" IsChecked="{Binding ShouldSelectAllDegrees}" /> -->
                        <!-- </Grid> -->
                        <ItemsControl Margin="28,0,0,0" ItemsSource="{Binding ChordQualities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid ColumnSpacing="20" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,2"
                                        Content="{Binding Label}"
                                        FontFamily="{StaticResource NotoSans}"
                                        IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Button
                    Classes="Primary"
                    Command="{Binding TogglePlay}"
                    Content="Play"
                    IsVisible="{Binding !Game.IsPlaying}" />
                <Button
                    Classes="Secondary"
                    Command="{Binding TogglePlay}"
                    Content="Stop"
                    IsVisible="{Binding Game.IsPlaying}" />
            </StackPanel>
        </shadui:Card>
    </Grid>
</UserControl>
